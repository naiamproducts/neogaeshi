{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "cyan", "green", "blue", "yellow", "orange", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$hue.interactive.400",
          "$hovered": "$hue.interactive.300",
          "$focused": "$hue.interactive.300",
          "$pressed": "$hue.interactive.500",
          "$selected": "$hue.interactive.500",
          "$disabled": "$hue.neutral.600"
        },
        "secondary": {
          "base": "$hue.accent.400",
          "$hovered": "$hue.accent.300",
          "$focused": "$hue.accent.300",
          "$pressed": "$hue.accent.500",
          "$selected": "$hue.accent.500",
          "$disabled": "$hue.neutral.600"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$hovered": "$hue.red.300",
          "$focused": "$hue.red.300",
          "$pressed": "$hue.red.500",
          "$selected": "$hue.red.500",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.neutral.100",
        "$focused": "$hue.neutral.100",
        "$pressed": "$hue.neutral.300",
        "$selected": "$hue.neutral.100",
        "$disabled": "$hue.neutral.600"
      },
      "feedback": {
        "error": { "base": "$hue.red.400", "muted": "$hue.red.500" },
        "warning": { "base": "$hue.orange.400", "muted": "$hue.orange.500" },
        "success": { "base": "$hue.green.400", "muted": "$hue.green.500" },
        "info": { "base": "$hue.blue.400", "muted": "$hue.blue.500" }
      }
    },
    "background": {
      "base": "#12101a",
      "raised": {
        "base": "#171226",
        "high": "#1e1830",
        "max": "#261f3b"
      },
      "action": {
        "primary": {
          "base": "$hue.accent.600",
          "$hovered": "$hue.accent.500",
          "$focused": "$hue.accent.500",
          "$pressed": "$hue.accent.700",
          "$selected": "$hue.accent.700",
          "$disabled": "$hue.neutral.800"
        },
        "secondary": {
          "base": "$hue.neutral.800",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.neutral.700",
          "$pressed": "$hue.neutral.900",
          "$selected": "$hue.neutral.700",
          "$disabled": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.red.600",
          "$hovered": "$hue.red.500",
          "$focused": "$hue.red.500",
          "$pressed": "$hue.red.700",
          "$selected": "$hue.red.700",
          "$disabled": "$hue.neutral.800"
        }
      },
      "formfield": {
        "base": "$hue.neutral.900",
        "$hovered": "$hue.neutral.800",
        "$focused": "$hue.neutral.800",
        "$pressed": "$hue.neutral.900",
        "$selected": "$hue.neutral.800",
        "$disabled": "$hue.neutral.900"
      },
      "feedback": {
        "error": { "base": "$hue.red.900" },
        "warning": { "base": "$hue.orange.900" },
        "success": { "base": "$hue.green.900" },
        "info": { "base": "$hue.blue.900" }
      }
    },
    "border": { "base": "$hue.neutral.700" },
    "scrollbar": { "base": "$hue.neutral.600" },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300",
        "context": "$hue.neutral.200",
        "hunkHeader": "$hue.cyan.300"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$background.base"
      },
      "highlight": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800"
      },
      "lineNumber": {
        "text": "$hue.neutral.600",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.500",
      "keyword": "$hue.purple.300",
      "function": "$hue.cyan.300",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.300",
      "number": "$hue.orange.300",
      "type": "$hue.blue.300",
      "operator": "$hue.cyan.400",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.300",
      "link": "$hue.cyan.400",
      "linkText": "$hue.cyan.300",
      "code": "$hue.green.300",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.neutral.300",
      "strong": "$hue.neutral.100",
      "horizontalRule": "$hue.neutral.700",
      "listItem": "$hue.neutral.300",
      "listEnumeration": "$hue.purple.400",
      "image": "$hue.blue.300",
      "imageText": "$hue.blue.400",
      "codeBlock": "$hue.neutral.100"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#e6e1f0",
        "200": "#cfc8dd",
        "300": "#b0a7c4",
        "400": "#8d83a6",
        "500": "#6f6689",
        "600": "#564e6d",
        "700": "#3f3953",
        "800": "#2b263c",
        "900": "#1a1628"
      },
      "red": {
        "100": "#ffd9d9",
        "200": "#ffb8b8",
        "300": "#ff9494",
        "400": "#f97070",
        "500": "#e15252",
        "600": "#c13b3b",
        "700": "#9c2f2f",
        "800": "#742424",
        "900": "#501a1a"
      },
      "orange": {
        "100": "#ffe3c9",
        "200": "#ffcca1",
        "300": "#fdb478",
        "400": "#f79a4f",
        "500": "#df7f35",
        "600": "#c06627",
        "700": "#9a4f1f",
        "800": "#723a19",
        "900": "#4f2913"
      },
      "yellow": {
        "100": "#fdf0c0",
        "200": "#fbe397",
        "300": "#f8d16d",
        "400": "#f2bc45",
        "500": "#dda42e",
        "600": "#b88523",
        "700": "#91681d",
        "800": "#6b4c17",
        "900": "#4a3512"
      },
      "green": {
        "100": "#d3f5cf",
        "200": "#b0e9aa",
        "300": "#89db83",
        "400": "#64c95f",
        "500": "#4aad47",
        "600": "#3a8c39",
        "700": "#2f6d2e",
        "800": "#235123",
        "900": "#183a19"
      },
      "cyan": {
        "100": "#cdfbf3",
        "200": "#a3f4e6",
        "300": "#78e9d6",
        "400": "#4ed6c1",
        "500": "#33b8a6",
        "600": "#279588",
        "700": "#1e736a",
        "800": "#175650",
        "900": "#103d3a"
      },
      "blue": {
        "100": "#cfe3ff",
        "200": "#a8cbff",
        "300": "#7fb2ff",
        "400": "#5896f7",
        "500": "#3c79db",
        "600": "#2d5fbb",
        "700": "#234a97",
        "800": "#1a3670",
        "900": "#132650"
      },
      "purple": {
        "100": "#e9d5ff",
        "200": "#d5b3ff",
        "300": "#be93fb",
        "400": "#a678f0",
        "500": "#8c5ce0",
        "600": "#7346c2",
        "700": "#59339c",
        "800": "#3f2275",
        "900": "#2a1452"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    }
  }
}
